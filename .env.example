# Telegram Bot Token
# Get your bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Firebase Service Account
# Download service account JSON from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Convert to single-line JSON (jq -c .) and paste below
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\nMIIE...\\n-----END PRIVATE KEY-----\\n",...}

# Authorized Telegram User IDs (comma-separated)
# Get your user ID by messaging @userinfobot in Telegram
# Example: AUTHORIZED_USER_IDS=123456789,987654321
# Leave empty to allow all users (NOT SECURE - only for development)
AUTHORIZED_USER_IDS=

# Port (Render sets this automatically)
PORT=3000
